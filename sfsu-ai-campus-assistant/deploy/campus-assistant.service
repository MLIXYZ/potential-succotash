# Installed/updated automatically by run.sh into /etc/systemd/system/.
[Unit]
Description=SFSU AI Campus Assistant backend (FastAPI + in-process RAG)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/potential-succotash/sfsu-ai-campus-assistant/backend
# backend/.env is loaded by the app itself (python-dotenv)
Environment=PYTHONUNBUFFERED=1
# One worker: each worker would load its own copy of the embedding model.
ExecStart=/opt/potential-succotash/sfsu-ai-campus-assistant/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# Model load (and first-run download) can take a while.
TimeoutStartSec=300
# Keep a runaway process from taking down Postgres on the 6 GB VM.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
